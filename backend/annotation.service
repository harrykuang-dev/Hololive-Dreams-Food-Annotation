[Unit]
Description=Shared cooking annotation API
After=network.target

[Service]
Type=simple
User=cooking-annotation
Group=cooking-annotation
WorkingDirectory=/opt/cooking-annotation
EnvironmentFile=/etc/cooking-annotation.env
ExecStart=/usr/bin/python3 /opt/cooking-annotation/server.py
Restart=on-failure
RestartSec=3
MemoryMax=256M
CPUQuota=25%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cooking-annotation

[Install]
WantedBy=multi-user.target
